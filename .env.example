# API_PORT: Local backend port used by the Express API.
API_PORT="3001"

# NODE_ENV: Use "production" for deployed builds.
NODE_ENV="development"

# ADMIN_TOKEN: Token required to read /api/messages in production.
# If omitted, /api/messages is open only while running locally.
ADMIN_TOKEN="change-me"

# TRUST_PROXY: Set to "true" when deployed behind a trusted reverse proxy/load balancer.
TRUST_PROXY="false"

# SMTP mail delivery for the contact form.
# For Gmail, use SMTP_HOST="smtp.gmail.com", SMTP_PORT="587",
# SMTP_USER with your Gmail address, and SMTP_PASS with a Gmail app password.
CONTACT_TO="avishekhjhaaj@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="A. K. Portfolio <your-email@gmail.com>"
